# Review Agent 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# ====================
# 应用配置
# ====================
ENV=development
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ====================
# 数据库配置
# ====================
DATABASE_ENGINE=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=review_agent
DATABASE_USER=review_agent
DATABASE_PASSWORD=review_agent_password

# SQLite 配置 (开发环境可选)
# DATABASE_URL=sqlite:///db.sqlite3

# ====================
# Redis 配置
# ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_BACKEND_URL=redis://localhost:6379/0

# ====================
# GitLab 配置
# ====================
GITLAB_URL=https://gitlab.com
GITLAB_ACCESS_TOKEN=your-gitlab-access-token
GITLAB_WEBHOOK_SECRET=your-webhook-secret
GITLAB_TIMEOUT=30
GITLAB_MAX_RETRIES=3

# ====================
# AI/LLM 配置
# ====================
# AI 提供商: litellm, openai, anthropic
AI_PROVIDER=litellm
AI_MODEL=gpt-4o
AI_API_KEY=your-ai-api-key
AI_API_BASE=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=16000
AI_TIMEOUT=120

# 备用模型 (可选)
AI_FALLBACK_MODELS=gpt-4o-mini,gpt-3.5-turbo

# ====================
# 审查配置
# ====================
# 自动审查
AUTO_REVIEW_ON_OPEN=false
AUTO_REVIEW_ON_PUSH=false
AUTO_REVIEW_COMMANDS=/describe,/review
IGNORE_DRAFT=true

# 并发控制
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=1800

# ====================
# 日志配置
# ====================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=

# ====================
# Celery 配置
# ====================
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=100
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_TIME_LIMIT=1800

# ====================
# 安全配置
# ====================
# CORS 允许的源
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# JWT 配置
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ====================
# 其他配置
# ====================
# 时区
TIME_ZONE=Asia/Shanghai

# 语言代码
LANGUAGE_CODE=zh-hans

# 静态文件
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
